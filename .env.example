# ─────────────────────────────────────────────────────────────────────────────
# AI LifeOS — example environment file
#
# Copy this to `.env` and fill in real values. NEVER commit `.env`.
# Secrets in this file are for the BACKEND (Express) only. The frontend receives
# ONLY the public Firebase web config (the VITE_* vars below), never any secret.
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# BACKEND (Express) — server-only secrets. Never expose these to the client.
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Firebase Admin SDK ---
# From a service-account JSON key (Firebase console → Project settings →
# Service accounts → Generate new private key). Keep the private key on the
# server only.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# Paste the full private key; keep the literal \n escapes on one line, e.g.
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Field-level encryption (for journal / sensitive fields, Phase 3) ---
# 32-byte key, base64 or hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_ME_32_BYTE_KEY

# --- LLM providers (provider-agnostic layer; configure at least one) ---
# Primary recommendation: Groq or Google Gemini Flash. OpenRouter as fallback.
AI_PROVIDER=groq                       # groq | gemini | openrouter | mistral | cerebras
AI_MODEL=llama-3.3-70b-versatile       # provider-specific model id
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=                       # NOTE: do NOT route journal/mood through free Mistral
CEREBRAS_API_KEY=

# --- Weather (no key required) ---
# Open-Meteo needs no API key; base URL kept here only if you want to override.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- Error tracking (optional) ---
SENTRY_DSN=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# FRONTEND (Vite) — PUBLIC Firebase web config only. Safe to ship to the client.
# These are the public web-app config values, NOT the Admin service account.
# Vite exposes only variables prefixed with VITE_.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the Express API the frontend calls.
VITE_API_BASE_URL=http://localhost:4000/api/v1
