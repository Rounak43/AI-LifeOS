# Backend-local copy — see the root .env.example for the full annotated list.
# Copy this to backend/.env (gitignored). Server-only secrets; never shipped to the client.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Firebase Admin SDK (service account) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Field-level encryption (journal etc., Phase 3) ---
ENCRYPTION_KEY=REPLACE_ME_32_BYTE_KEY

# --- AI (Phase 5) ---
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
