# Frontend env — PUBLIC Firebase web config only (safe to ship to the client).
# Copy to frontend/.env.local (gitignored). Vite exposes only VITE_* variables.
# NEVER put the Firebase Admin service account or any LLM key here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the Express API.
VITE_API_BASE_URL=http://localhost:4000/api/v1
